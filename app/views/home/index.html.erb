<% if flash[:delete_notice] %>
  <script>alert("<%= j flash[:delete_notice] %>");</script>
<% end %>
<h1>YCBA - Remove record from catalog</h1>
<p>You are logged in as: <b><%= current_user.uid %></b></p>

<%= form_tag("/home/confirm", method: "get") do %>
  <%#= label_tag(:code, "Code:") %>
  <%#= text_field_tag(:code) %>
  <%= label_tag(:id, "Solr ID:") %>
  <%= text_field_tag(:id) %>
  <%= submit_tag("Search") %>
<% end %>
</br>
<%#= link_to "Logout", destroy_user_session_path, :method => :delete %>

<hr>
<h2>Check outdated records</h2>

<%= form_tag("/home/delete_lookup", method: "get") do %>
  <%= hidden_field_tag :yesterday, @yesterday %>
  <%= label_tag :collection, "Collection:" %>
  <%= select_tag :collection, options_for_select([
    "Prints and Drawings",
    "Reference Library",
    "Rare Books and Manuscripts",
    "Archives",
    "Paintings and Sculpture",
    "Frames",
    "Artists"
  ], params[:collection]) %>
  <%= submit_tag "Search" %>
<% end %>

<% if !@collection.nil? %>
  <p><b><%= @docs.size %> record(s)</b> in <em><%= @collection %></em> with timestamp before <%= @yesterday %></p>
<% end %>
<% if @docs.present? %>
  <div style="max-height: 450px; overflow-y: auto;">
    <table class="sortable" border="1" cellpadding="4" cellspacing="0">
      <thead>
        <tr>
          <th class="unsortable">Delete</th>
          <th>ID</th>
          <% if @collection == "Artists" %>
            <th>LOCNAF</th>
          <% else %>
            <th>Title</th>
            <th>Author</th>
          <% end %>
          <th>Timestamp</th>
        </tr>
      </thead>
      <tbody>
        <% @docs.each do |doc| %>
          <tr>
            <td><input type="checkbox" onclick="confirmDeleteChecked(this, '<%= j doc["id"] %>')"></td>
            <td><%= doc["id"] %></td>
            <% if @collection == "Artists" %>
              <td><%= Array(doc["locnaf_ss"]).first %></td>
            <% else %>
              <td><%= Array(doc["title_ss"]).first %></td>
              <td><%= Array(doc["author_ss"]).first %></td>
            <% end %>
            <td style="white-space: nowrap;"><%= doc["timestamp_dt"]&.first(10) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <script>
    var returnUrl = "<%= j request.fullpath %>";
    function confirmDeleteChecked(checkbox, id) {
      if (confirm("Do you really want to delete this: " + id + "?")) {
        window.location.href = '/home/delete_checked?id=' + encodeURIComponent(id) + '&return_to=' + encodeURIComponent(returnUrl);
      } else {
        checkbox.checked = false;
      }
    }
  </script>
<% end %>
